# .env.prod — BookyHome producción
# Generado por Ansible el {{ ansible_date_time.iso8601 }}
# No editar manualmente: usar ansible-playbook para regenerar.

# ─── Versión ──────────────────────────────────────────────────────────────────
APP_VERSION={{ app_version }}
REGISTRY={{ registry }}

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_USER={{ db_user_app }}
DB_PASSWORD={{ vault_db_password_app }}
DB_NAME={{ db_name }}
DB_MIGRATION_USER={{ db_user_owner }}
DB_MIGRATION_PASSWORD={{ vault_db_password_owner }}

# ─── Backend ─────────────────────────────────────────────────────────────────
PUBLIC_API_URL={{ public_api_url }}
FRONTEND_URL={{ frontend_url }}

# JWT
SECRET_KEY={{ vault_secret_key }}

# ─── Correo transaccional ─────────────────────────────────────────────────────
MAIL_USERNAME={{ vault_mail_username }}
MAIL_PASSWORD={{ vault_mail_password }}
MAIL_FROM={{ vault_mail_from }}
MAIL_SERVER={{ mail_server }}
MAIL_PORT={{ mail_port }}
MAIL_STARTTLS={{ mail_starttls }}
MAIL_SSL_TLS={{ mail_ssl_tls }}

# ─── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY={{ vault_gemini_api_key }}
GEMINI_MODEL={{ gemini_model }}
GEMINI_BASE_URL={{ gemini_base_url }}

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL={{ vite_api_base_url }}

# ─── BookyPago ────────────────────────────────────────────────────────────────
BOOKYPAGO_COMISION={{ bookypago_comision }}
BOOKYPAGO_COMISION_FIJA={{ bookypago_comision_fija }}
BOOKYPAGO_SALDO_MINIMO={{ bookypago_saldo_minimo }}
BOOKYPAGO_SALDO_MAXIMO={{ bookypago_saldo_maximo }}
BOOKYPAGO_COMISION_VENTA={{ bookypago_comision_venta }}
BOOKYPAGO_COMISION_IMPULSO={{ bookypago_comision_impulso }}
BOOKYPAGO_COMISION_PLAN={{ bookypago_comision_plan }}
BOOKYPAGO_DIAS_PAGO={{ bookypago_dias_pago }}
BOOKYPAGO_MINIMO_PAGO={{ bookypago_minimo_pago }}
