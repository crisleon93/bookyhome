# Configuración de correo para recuperación de contraseña
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM=tu_correo@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# URL pública del backend (accesible desde el móvil/red local).
# Usada en el enlace "Confirmar correo" del email de registro.
# Debe ser la IP de tu PC en la red WiFi, NO localhost.
PUBLIC_API_URL=http://192.168.1.10:8000

# URL del frontend web (recuperación de contraseña, login web)
FRONTEND_URL=http://localhost:5173

# Variables de la Base de Datos para Docker y Backend
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bookyhome

# Configuración de BookyPago (Sistema de pagos interno)
BOOKYPAGO_COMISION=0.05
BOOKYPAGO_COMISION_FIJA=0.00
BOOKYPAGO_SALDO_MINIMO=0.00
BOOKYPAGO_SALDO_MAXIMO=10000000.00

# Configuración de BookyPago Finanzas (Sistema financiero de BookyHome)
BOOKYPAGO_COMISION_VENTA=0.10
BOOKYPAGO_COMISION_IMPULSO=0.05
BOOKYPAGO_COMISION_PLAN=0.02
BOOKYPAGO_DIAS_PAGO=7
BOOKYPAGO_MINIMO_PAGO=50000
