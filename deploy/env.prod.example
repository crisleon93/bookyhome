# env.prod.example — BookyHome producción
# Copiar como .env.prod en el servidor y completar todos los valores.
# NUNCA subir .env.prod al repositorio (está en .gitignore).

# ─── Versión ──────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
REGISTRY=ghcr.io/bookyhome

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambia_esta_contrasena_en_produccion
DB_NAME=bookyhome

# ─── Backend / API ────────────────────────────────────────────────────────────
PUBLIC_API_URL=https://api.bookyhome.com.co
FRONTEND_URL=https://bookyhome.com.co

# JWT — generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=genera_una_clave_secreta_aleatoria_de_64_hex

# ─── Correo transaccional ─────────────────────────────────────────────────────
MAIL_USERNAME=correo@bookyhome.com.co
MAIL_PASSWORD=app_password_del_proveedor
MAIL_FROM=correo@bookyhome.com.co
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ─── Gemini (asistente IA) ────────────────────────────────────────────────────
GEMINI_API_KEY=pega_tu_clave_de_google_ai_studio
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://api.bookyhome.com.co

# ─── BookyPago ────────────────────────────────────────────────────────────────
BOOKYPAGO_COMISION=0.05
BOOKYPAGO_COMISION_FIJA=0.00
BOOKYPAGO_SALDO_MINIMO=0.00
BOOKYPAGO_SALDO_MAXIMO=10000000.00
BOOKYPAGO_COMISION_VENTA=0.10
BOOKYPAGO_COMISION_IMPULSO=0.05
BOOKYPAGO_COMISION_PLAN=0.02
BOOKYPAGO_DIAS_PAGO=7
BOOKYPAGO_MINIMO_PAGO=50000
